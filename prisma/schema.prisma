// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // runtime (can be pooler in prod, or direct in dev)
  directUrl = env("DIRECT_URL")     // ALWAYS direct 5432 for migrate/seed
}

model State {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique @db.VarChar(80)
  code        String   @unique @db.VarChar(2)
  description String?
  population  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  programs Program[]

  @@index([name])
  @@index([slug])
  @@map("states")
}

model Program {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique @db.VarChar(140)
  description String
  amount      String?  // e.g., "Up to $50,000"
  deadline    DateTime?
  url         String   // Application URL
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  stateId String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  // SEO
  metaTitle       String?
  metaDescription String?

  @@index([stateId, active])
  @@index([featured, active, createdAt])
  @@index([deadline])
  @@map("programs")
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
  active   Boolean @default(true)

  @@map("faqs")
}

model HealthCheck {
  id        BigInt   @id @default(autoincrement())
  name      String
  ok        Boolean
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
  @@index([createdAt], map: "idx_health_checks_created_at")
}


